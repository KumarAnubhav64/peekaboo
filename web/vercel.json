{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://<YOUR-USERNAME>-peekaboo.hf.space/api/:path*"
    },
    {
      "source": "/health",
      "destination": "https://<YOUR-USERNAME>-peekaboo.hf.space/health"
    },
    {
      "source": "/((?!assets/).*)",
      "destination": "/index.html"
    }
  ]
}
