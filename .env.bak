# ---------------------------------------------------------------------------
# FaceClaim configuration — copy to .env and fill in
# ---------------------------------------------------------------------------

# Neon Postgres connection string (free tier). Create one at https://console.neon.tech
# Use the "Pooled connection string" (-pooler host) for the app.
# Local alternative: docker run -d --name faceclaim-pg -p 5433:5432 \
#   -e POSTGRES_PASSWORD=postgres -e POSTGRES_DB=faceclaim pgvector/pgvector:pg16
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/faceclaim

# Cosine-similarity threshold for a face match (ArcFace). 0.0-1.0.
# Higher = stricter. 0.42 is a good default for buffalo_l.
MATCH_THRESHOLD=0.42

# Where uploaded photos, face crops and selfies are stored on disk.
DATA_DIR=data

# Where InsightFace model files live (auto-downloaded on first run).
MODEL_DIR=models

# InsightFace model pack: buffalo_l (accurate, ~370MB) or buffalo_s (smaller, ~160MB).
FACE_MODEL=buffalo_l

# Face detector input size. 640 = good accuracy/speed balance on CPU.
DET_SIZE=640

# Upload limits.
MAX_UPLOAD_MB=20
MAX_IMAGE_SIDE=2048

# Optional: set when running behind a proxy/domain so share links are absolute.
# e.g. PUBLIC_BASE_URL=https://faceclaim.example.com
PUBLIC_BASE_URL=
