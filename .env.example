# ---------------------------------------------------------------------------
# Peekaboo configuration — copy to .env and fill in
# ---------------------------------------------------------------------------

# Neon Postgres connection string (free tier). Create one at https://console.neon.tech
# Use the "Pooled connection string" (-pooler host) for the app.
# Local alternative: docker run -d --name faceclaim-pg -p 5433:5432 \
#   -e POSTGRES_PASSWORD=postgres -e POSTGRES_DB=faceclaim pgvector/pgvector:pg16
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/faceclaim

# Cosine-similarity threshold for a face match (ArcFace). 0.0-1.0.
# Higher = stricter. 0.42 is a good default for buffalo_l.
MATCH_THRESHOLD=0.42

# Where uploaded photos, face crops and selfies are stored.
#   STORAGE_BACKEND=local -> disk under DATA_DIR (default, laptop)
#   STORAGE_BACKEND=s3    -> S3-compatible object storage (free)
#       local dev:  MinIO          (docker run -p 9000:9000 minio/minio server /data)
#       production: Cloudflare R2  (10 GB free, zero egress)
STORAGE_BACKEND=local
DATA_DIR=data

# --- S3-compatible storage (only when STORAGE_BACKEND=s3) ---
# Standard AWS SDK env names are used (S3_* legacy names also work).
#
# MinIO local:  S3_ENDPOINT_URL=http://localhost:9000, keys=minioadmin/minioadmin, region=us-east-1
# Cloudflare R2: S3_ENDPOINT_URL=https://<ACCOUNT_ID>.r2.cloudflarestorage.com, region=auto
# Neon object storage (free): copy the S3 endpoint + access key/secret from
#   Neon console -> Storage -> S3-compatible; bucket name is per-project
#   (e.g. `pekaboo`).
AWS_ENDPOINT_URL_S3=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=auto
S3_BUCKET=pekaboo

# Where InsightFace model files live (auto-downloaded on first run).
MODEL_DIR=models

# InsightFace model pack: buffalo_l (accurate, ~370MB) or buffalo_s (smaller, ~160MB).
FACE_MODEL=buffalo_l

# Face detector input size. 640 = good accuracy/speed balance on CPU.
DET_SIZE=640

# Upload limits.
MAX_UPLOAD_MB=20
MAX_IMAGE_SIDE=2048

# --- Auth ---
# Secret used to sign session cookies. Generate with: python -c "import secrets; print(secrets.token_hex(32))"
# IMPORTANT: change in production!
JWT_SECRET=dev-only-secret-change-me-in-production
SESSION_DAYS=30
# Set true only when serving over HTTPS (production).
COOKIE_SECURE=false

# --- Google SSO (optional) ---
# 1. https://console.cloud.google.com/apis/credentials -> Create OAuth client ID (Web application)
# 2. Authorized redirect URI: {PUBLIC_BASE_URL}/api/auth/google/callback
# 3. Leave empty to disable Google sign-in.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional: set when running behind a proxy/domain so share links are absolute.
# e.g. PUBLIC_BASE_URL=https://peekaboo.example.com
PUBLIC_BASE_URL=
